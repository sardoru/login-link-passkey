# login-link-passkey — environment
# Copy to .env.local for local dev; set the same keys in your host (e.g. Vercel).

# Canonical site URL — magic-link base, invite links, OG images, WebAuthn origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (auth store). Service-role key is SERVER-ONLY — never expose it.
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend — magic links, invite/welcome emails, waitlist mail all use this key.
# FROM must use a Resend-verified domain.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Acme <login@your-verified-domain>

# Session + challenge signing secret — long random string:  openssl rand -base64 48
AUTH_JWT_SECRET=

# Comma-separated allow-list of emails permitted to sign in.
# Anyone created, invited, or admitted by access code is allowed regardless.
# Leave empty to allow ANY email (NOT recommended for confidential apps).
AUTH_ALLOWED_EMAILS=

# Emails promoted to `owner` on first sign-in — how the first admin is created.
# Set this before your first login, then remove it once the owner exists.
AUTH_BOOTSTRAP_OWNERS=you@example.com

# ── Admin / invites / codes / waitlist ──────────────────────────────────────
# Invite links expire after this many days (default 3).
# AUTH_INVITE_TTL_DAYS=3
# Default seat count on a new access code (admin can override per code).
# AUTH_CODE_DEFAULT_USES=10
# Set to "false" to 404 the public /waitlist page and refuse the API.
# AUTH_WAITLIST_ENABLED=true
# Where an admin's "email setup link" lands after sign-in — must render
# <PasskeyPrompt/>, which opens on ?passkey=setup (default "/?passkey=setup").
# AUTH_PASSKEY_SETUP_PATH=/?passkey=setup

# Optional WebAuthn overrides (default: derived from the request host).
# AUTH_RP_ID=app.example.com
# AUTH_RP_NAME=Acme
