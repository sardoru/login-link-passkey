# login-link-passkey — environment
# Copy to .env.local for local dev; set the same keys in your host (e.g. Vercel).

# Canonical site URL — magic-link base, email logo, WebAuthn origin/rpID.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (auth store). Service-role key is SERVER-ONLY — never expose it.
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend (branded magic-link email). FROM must use a Resend-verified domain.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Acme <login@your-verified-domain>

# Session + challenge signing secret — long random string:  openssl rand -base64 48
AUTH_JWT_SECRET=

# Comma-separated allow-list of emails permitted to sign in.
# Leave empty to allow ANY email (NOT recommended for confidential apps).
AUTH_ALLOWED_EMAILS=

# Optional WebAuthn overrides (default: derived from the request host).
# AUTH_RP_ID=app.example.com
# AUTH_RP_NAME=Acme
